
import tkinter as tk
from tkinter import ttk
import subprocess
import threading
import queue
import os
import signal
from pathlib import Path
from datetime import datetime

# Project paths
BASE_DIR = Path(__file__).resolve().parent.parent
BIN_DIR = BASE_DIR / "bin"

# Main window
app = tk.Tk()
app.title("Multithreaded Linux Application Simulator")
app.geometry("1100x720")
app.minsize(850, 600)
app.configure(bg="#101827")

events = queue.Queue()
processes = {}

# ---------- LOGGING ----------

def add_log(message):
    timestamp = datetime.now().strftime("%H:%M:%S")
    log_box.configure(state="normal")
    log_box.insert(tk.END, f"[{timestamp}] {message}\n")
    log_box.see(tk.END)
    log_box.configure(state="disabled")


# ---------- STATUS ----------

def update_status(module, status):
    if module == "thread":
        thread_status.config(text=status)
    elif module == "process":
        process_status.config(text=status)


# ---------- OUTPUT READER ----------

def read_output(module, process):
    try:
        for line in process.stdout:
            events.put(("output", module, line.rstrip()))
        process.wait()
        events.put(("finished", module, process.returncode))
    except Exception as error:
        events.put(("output", module, f"Reader error: {error}"))


# ---------- START PROGRAM ----------

def start_module(module, executable):

    if module in processes:
        if processes[module].poll() is None:
            add_log(f"{module} module is already running.")
            return

    program = BIN_DIR / executable

    if not program.is_file():
        add_log(f"ERROR: {program} does not exist.")
        add_log("Compile the C program before starting it.")
        return

    try:
        process = subprocess.Popen(
            [str(program)],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            start_new_session=True
        )

        processes[module] = process

        update_status(module, "RUNNING")
        add_log(f"Started {executable}")
        add_log(f"Process PID: {process.pid}")

        worker = threading.Thread(
            target=read_output,
            args=(module, process),
            daemon=True
        )
        worker.start()

    except OSError as error:
        update_status(module, "ERROR")
        add_log(f"Execution error: {error}")


def start_threads():
    start_module("thread", "thread_manager")


def start_process():
    start_module("process", "process_termination")


# ---------- STOP PROGRAMS ----------

def stop_module():

    active = False

    for module, process in list(processes.items()):

        if process.poll() is None:

            try:
                os.killpg(process.pid, signal.SIGTERM)
                update_status(module, "STOPPING")
                add_log(f"Termination requested for {module}.")
                active = True

            except ProcessLookupError:
                pass

    if not active:
        add_log("No active programs to terminate.")


# ---------- CLEAR LOGS ----------

def clear_logs():
    log_box.configure(state="normal")
    log_box.delete("1.0", tk.END)
    log_box.configure(state="disabled")


# ---------- PROCESS EVENTS ----------

def process_events():

    while True:

        try:
            event = events.get_nowait()

        except queue.Empty:
            break

        if event[0] == "output":

            _, module, message = event
            add_log(f"[{module.upper()}] {message}")

        elif event[0] == "finished":

            _, module, return_code = event

            if return_code == 0:
                update_status(module, "COMPLETED")
            else:
                update_status(module, "STOPPED / ERROR")

            add_log(
                f"{module.upper()} finished. Exit code: {return_code}"
            )

    app.after(100, process_events)


