def create_card(parent, title, value):

    card = tk.Frame(
        parent,
        bg="#24334A",
        padx=15,
        pady=18
    )

    card.pack(side="left", fill="both", expand=True, padx=7)

    tk.Label(
        card,
        text=title,
        font=("Arial", 11, "bold"),
        bg="#24334A",
        fg="#B8C7DC"
    ).pack()

    label = tk.Label(
        card,
        text=value,
        font=("Arial", 17, "bold"),
        bg="#24334A",
        fg="#4ADE80"
    )

    label.pack(pady=10)

    return label


